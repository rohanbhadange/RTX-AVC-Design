  <classification name="RTX Drone ? Density Only"><material name="PAHT-CF - 1060 kg-m3 - density only" description="Preliminary CAD mass only; no validated mechanical or thermal properties. CF tube density matches nominal supplier linear mass; printed material depends on process." envdata="1">
      <shaders>
        <pwshader2 name="carbon steel" isNewShader="1" path="\metal\steel\carbon steel.p2m" />
        <cgshader2 name="SteelPlainCarbon" />
        <pwshader name="polished steel" />
        <cgshader name="SteelPlainCarbon" />
        <swtexture path="images\textures\metal\cast\cast_fine.jpg" />
      </shaders>
      <swatchcolor RGB="505050">
        <ns2:Optical Ambient="1.000000" Transparency="0.000000" Diffuse="0.790000" Specularity="0.880000" Shininess="0.210000" Emission="0.210000" />
      </swatchcolor>
      <xhatch name="ANSI32 (Steel)" angle="0.0" scale="1.0" />
      <physicalproperties>
        <DENS displayname="Mass Density" value="1060" usepropertycurve="0" />
      </physicalproperties>
    </material>
